{
  "version": 2,
  "description": "热点猎手 v2 — 影视(50%) + 社会热点(50%) 双轨采集",
  "last_updated": "2026-05-25",
  "sources": {
    "trendapi": {
      "name": "TrendAPI 全站雷达",
      "type": "api",
      "endpoint": "https://trendapi.tgmeng.com/api/skill/search",
      "mode": "REALTIME",
      "script": "employees/scripts/trendapi-fetch.py",
      "output_format": "json",
      "category_film": ["影音", "时光网", "美漫百科", "3DMGAME", "游侠网", "豆瓣"],
      "category_social": ["新闻", "生活", "社区", "媒体"],
      "enabled": false,
      "note": "❌ 已停用：游戏/动漫为主，影视内容少且质量低，token浪费严重"
    },
    "thepaper": {
      "name": "澎湃新闻直连",
      "type": "direct_scrape",
      "url": "https://www.thepaper.cn/",
      "script": "employees/scripts/thepaper-fetch.py",
      "output_format": "json",
      "enabled": false,
      "note": "❌ 已停用：零影视相关产出，纯浪费"
    },
    "dailyhot": {
      "name": "DailyHot 垂直热榜",
      "type": "api",
      "base_url": "http://192.168.100.223:6688",
      "script": "employees/scripts/dailyhot-fetch.py",
      "sources": {
        "douban-movie": {"enabled": true, "note": "豆瓣新片榜（片单，非文章）"},
        "zhihu": {"enabled": true, "note": "知乎热榜（可筛选影视话题）"},
        "bilibili": {"enabled": true, "note": "B站热榜"},
        "douyin": {"enabled": true, "note": "抖音热榜"},
        "hupu": {"enabled": true, "note": "虎扑步行街"}
      }
    },
    "google_search": {
      "name": "Google Custom Search",
      "type": "api",
      "note": "备用。当TrendAPI产出不足时用于补充搜索。site:限定搜开放站点。",
      "enabled": false
    },
    "article_fetcher": {
      "name": "旧版文章抓取器",
      "script": "employees/scripts/article-fetcher.py",
      "enabled": false,
      "note": "已弃用。由TrendAPI + thepaper直连替代。保留作为历史参考。"
    }
  },
  "output": {
    "corpus_dir": "employees/article-corpus/{date}/",
    "sub_dirs": ["film", "social"],
    "research_dir": "employees/research-daily/",
    "metadata_file": "metadata.json",
    "pipeline_log": "{date}-pipeline-log.md"
  },
  "filters": {
    "max_fetch": 15,
    "film_include_keywords": [
      "电影", "电视剧", "综艺", "纪录片", "动画", "动漫", "短剧",
      "导演", "演员", "演技", "剧本", "编剧", "票房", "院线", "上映",
      "影评", "影帝", "影后", "好莱坞", "Netflix", "网飞", "漫威", "DC",
      "戛纳", "奥斯卡", "金鸡", "预告片", "剧集", "网剧"
    ],
    "film_exclude_keywords": [
      "光伏", "储能", "期货", "股票", "基金",
      "GitHub", "CUDA", "API", "开源"
    ],
    "social_include_sources": [
      "澎湃新闻", "新京报", "中国新闻网",
      "头条新闻", "腾讯新闻", "网易新闻", "百度新闻",
      "微博", "抖音", "知乎", "虎扑体育",
      "央视电视台",
      "ZAKER", "BBC", "纽约时报", "法广", "星岛环球"
    ],
    "social_exclude_keywords": [
      "光伏", "储能", "风电", "期货", "快讯", "开盘", "收盘",
      "煤炭", "原油", "钢铁", "有色金属", "钢管",
      "国家电网", "国家电投", "节能风电",
      "国考", "公务员", "考研", "教师资格",
      "Flutter", "GitHub", "CUDA", "Docker", "开源"
    ],
    "min_word_count": 200
  }
}
