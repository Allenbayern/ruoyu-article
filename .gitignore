*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs / local tooling
.venv/
venv/
.env
.env.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Audit trail — never daily-commit material (Slice 6)
runs/
reviews/
docs/
ARTICLE_GROUP_OPERATING_CONTRACT_v1_DRAFT.md

# Local scratch (never daily-commit material)
*.swp
*~

# Discarded per user instruction: keep on disk but untracked (audit/workspace hygiene)
briefs/
scripts/
references/learning-samples/

# media-intel-aios dormant backup (2026-08-07, SOL-ABSORB-003 fix): backup scripts/docs
# are retained repository artifacts and must be tracked; only the backup's own
# config/private/ is excluded (see projects/media-intel-aios/.gitignore).
!projects/media-intel-aios/scripts/
!projects/media-intel-aios/scripts/**
!projects/media-intel-aios/docs/
!projects/media-intel-aios/docs/**

# ...but never its bytecode cache (negate above would otherwise un-ignore it)
projects/media-intel-aios/scripts/__pycache__/

# Hermes desktop attachment cache (local only, never commit)
.hermes/

