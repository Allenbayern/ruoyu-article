# Disabled template: this file is declarative only. No systemctl action is
# performed by the dsh/Linux scheduling slice.

[Unit]
Description=Ruoyu Film Daily dsh article evidence timer (disabled template)

[Timer]
OnCalendar=*-*-* 17:00:00 Asia/Shanghai
Persistent=false
Unit=ruoyu-film-daily-dsh-article@%i.service

[Install]
WantedBy=timers.target