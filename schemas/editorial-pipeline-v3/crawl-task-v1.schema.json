{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crawl-task-v1.schema.json",
  "title": "Editorial Pipeline V3 crawl task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "topic_id",
    "topic_version",
    "status",
    "owner",
    "objective",
    "required_materials",
    "source_constraints",
    "stop_conditions",
    "retry",
    "deliverables",
    "created_at",
    "due_at"
  ],
  "properties": {
    "schema_version": {"const": "crawl-task-v1"},
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^crawl-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^topic-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "topic_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["researching", "material_ready", "returned", "closed"]},
    "owner": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "required_materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_facts", "industry_context", "audience_reactions", "cross_check_facts"],
      "properties": {
        "body_facts": {"$ref": "#/$defs/non_empty_strings"},
        "industry_context": {"$ref": "#/$defs/non_empty_strings"},
        "audience_reactions": {"$ref": "#/$defs/non_empty_strings"},
        "cross_check_facts": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "source_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_is_proof", "raw_html_as_writer_input"],
      "properties": {
        "discovery_is_proof": {"const": false},
        "raw_html_as_writer_input": {"const": false}
      }
    },
    "stop_conditions": {"$ref": "#/$defs/non_empty_strings"},
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts_per_source", "state"],
      "properties": {
        "max_attempts_per_source": {"type": "integer", "minimum": 1},
        "state": {
          "enum": ["not_started", "running", "retry_required", "exhausted", "complete"]
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "return_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "due_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
